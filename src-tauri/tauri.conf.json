{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchRoute",
  "version": "0.6.0",
  "identifier": "com.lalomorales.touchroute",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Hold fingers on your trackpad to run anything",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "fileAssociations": [
      {
        "ext": ["touchroute"],
        "name": "TouchRoute pack",
        "description": "A set of TouchRoute touches and drawings",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": { "identifier": "com.lalomorales.touchroute.pack", "conformsTo": ["public.json"] }
      }
    ]
  }
}
